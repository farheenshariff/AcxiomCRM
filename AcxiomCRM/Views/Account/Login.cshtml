@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Clean standalone authentication page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card-auth {
            border-radius: 1rem;
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.375);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card card-auth border-0 p-4 bg-white">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <div class="display-6 fw-bold text-dark">
                                <i class="bi bi-building-gear text-primary"></i> Acxiom<span class="text-primary">CRM</span>
                            </div>
                            <p class="text-muted small mt-1">Enterprise Customer Relationship Management</p>
                        </div>

                        <h4 class="fw-bold text-dark text-center mb-3">Sign In to Your Account</h4>

                        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="name@acxiomcrm.com" autofocus />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" asp-for="RememberMe" />
                                <label class="form-check-label small text-secondary" asp-for="RememberMe"></label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                            </button>
                        </form>

                        <hr class="my-4">

                        <div class="card bg-light border-0 p-3 mb-3 small">
                            <div class="fw-bold text-dark mb-1"><i class="bi bi-key-fill text-warning me-1"></i> Demo Test Credentials:</div>
                            <div class="text-muted"><strong>Admin:</strong> <code>admin@acxiomcrm.com</code> / <code>Admin@12345!</code></div>
                            <div class="text-muted"><strong>Manager:</strong> <code>manager@acxiomcrm.com</code> / <code>Manager@12345!</code></div>
                            <div class="text-muted"><strong>Sales:</strong> <code>sales@acxiomcrm.com</code> / <code>Sales@12345!</code></div>
                        </div>

                        <div class="text-center small">
                            <span class="text-muted">Don't have an account?</span>
                            <a asp-action="Register" class="fw-bold text-primary text-decoration-none">Register User</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
