@{
    ViewData["Title"] = "Access Denied";
}

<div class="container my-5 text-center">
    <div class="card border-0 shadow-lg p-5 mx-auto" style="max-width: 600px;">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-slash-fill display-1"></i>
        </div>
        <h2 class="fw-bold text-dark mb-3">Access Denied</h2>
        <p class="text-secondary lead">You do not have the required permissions or role privileges to view this page or perform this action.</p>

        <div class="alert alert-warning border my-3 py-2 small">
            <i class="bi bi-exclamation-triangle me-1"></i> If you believe this is an error, please contact your System Administrator.
        </div>

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold px-4 py-2">
                <i class="bi bi-house-door me-2"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
