@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card-auth {
            border-radius: 1rem;
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.375);
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card card-auth border-0 p-4 bg-white">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <div class="display-6 fw-bold text-dark">
                                <i class="bi bi-building-gear text-primary"></i> Acxiom<span class="text-primary">CRM</span>
                            </div>
                            <p class="text-muted small mt-1">Register New User Account</p>
                        </div>

                        <form asp-controller="Account" asp-action="Register" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="FullName" class="form-control" placeholder="John Doe" autofocus />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                                <input asp-for="Email" class="form-control" placeholder="name@acxiomcrm.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SelectedRole" class="form-label fw-semibold small text-secondary"></label>
                                <select asp-for="SelectedRole" class="form-select">
                                    <option value="SalesExecutive">Sales Executive</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <span asp-validation-for="SelectedRole" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary"></label>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="alert alert-info py-2 px-3 small my-2">
                                <i class="bi bi-shield-check me-1"></i> Password requirements: Minimum 8 characters with upper, lower, number, and special character.
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm mt-3">
                                <i class="bi bi-person-plus me-2"></i> Register Account
                            </button>
                        </form>

                        <div class="text-center small mt-4">
                            <span class="text-muted">Already registered?</span>
                            <a asp-action="Login" class="fw-bold text-primary text-decoration-none">Sign In</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
