<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM Enterprise</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body class="bg-light">
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top border-bottom border-secondary shadow-sm">
        <div class="container-fluid">
            <button class="btn btn-dark d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="navbar-brand fw-bold text-white d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="bi bi-building-gear text-primary fs-3 me-2"></i>
                <span>Acxiom<span class="text-primary">CRM</span></span>
            </a>

            <div class="collapse navbar-collapse" id="navbarNav">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- Main Container Layout with Sidebar -->
    <div class="container-fluid" style="padding-top: 60px;">
        <div class="row">
            <!-- Sidebar for Desktop -->
            <nav id="sidebar" class="col-md-3 col-lg-2 d-none d-lg-block bg-dark text-white sidebar min-vh-100 position-fixed pt-3 border-end border-secondary">
                <div class="position-sticky pt-2">
                    <ul class="nav flex-column gap-1 px-2">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 text-primary fs-5 me-3"></i>
                                <span class="fw-semibold text-white">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item text-uppercase text-white-50 small px-3 mt-3 mb-1 font-monospace" style="font-size: 0.75rem;">CRM Entities</li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="Customer" asp-action="Index">
                                <i class="bi bi-people text-info fs-5 me-3"></i>
                                <span class="text-white">Customers</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="Lead" asp-action="Index">
                                <i class="bi bi-person-badge text-warning fs-5 me-3"></i>
                                <span class="text-white">Leads</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="Opportunity" asp-action="Index">
                                <i class="bi bi-graph-up-arrow text-success fs-5 me-3"></i>
                                <span class="text-white">Opportunities</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="FollowUp" asp-action="Index">
                                <i class="bi bi-clock-history text-danger fs-5 me-3"></i>
                                <span class="text-white">Follow-Ups</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="Activity" asp-action="Index">
                                <i class="bi bi-check2-square text-info fs-5 me-3"></i>
                                <span class="text-white">Activities</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="Report" asp-action="Index">
                                <i class="bi bi-graph-up-arrow text-primary fs-5 me-3"></i>
                                <span class="text-white">Reports & Analytics</span>
                            </a>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item text-uppercase text-white-50 small px-3 mt-4 mb-1 font-monospace" style="font-size: 0.75rem;">Administration</li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="User" asp-action="Index">
                                        <i class="bi bi-person-gear text-danger fs-5 me-3"></i>
                                        <span class="text-white">Users & Roles</span>
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-white-50 rounded px-3 py-2 text-decoration-none d-flex align-items-center" asp-controller="AuditLog" asp-action="Index">
                                    <i class="bi bi-shield-check text-warning fs-5 me-3"></i>
                                    <span class="text-white">Audit Logs</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <!-- Offcanvas Sidebar for Mobile -->
            <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
                <div class="offcanvas-header border-bottom border-secondary">
                    <h5 class="offcanvas-title fw-bold" id="sidebarOffcanvasLabel"><i class="bi bi-building-gear text-primary me-2"></i>AcxiomCRM</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <ul class="nav flex-column gap-1">
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="Customer" asp-action="Index"><i class="bi bi-people me-2"></i>Customers</a></li>
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="Lead" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Leads</a></li>
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="Opportunity" asp-action="Index"><i class="bi bi-graph-up-arrow me-2"></i>Opportunities</a></li>
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="FollowUp" asp-action="Index"><i class="bi bi-clock-history me-2"></i>Follow-Ups</a></li>
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="Activity" asp-action="Index"><i class="bi bi-check2-square me-2"></i>Activities</a></li>
                        <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="Report" asp-action="Index"><i class="bi bi-graph-up-arrow me-2"></i>Reports & Analytics</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="User" asp-action="Index"><i class="bi bi-person-gear me-2"></i>Users & Roles</a></li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item"><a class="nav-link text-white py-2" asp-controller="AuditLog" asp-action="Index"><i class="bi bi-shield-check me-2"></i>Audit Logs</a></li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted small">
        <div class="container-fluid">
            <span>&copy; @DateTime.UtcNow.Year AcxiomCRM Enterprise Platform. All rights reserved. | Powered by ASP.NET Core MVC & Entity Framework Core</span>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
