@model List<AcxiomCRM.DTOs.UserActivityReportDto>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i>User Activity Report</h2>
        <p class="text-muted mb-0">Sales team activity metrics, assigned workload, and completion stats</p>
    </div>
    <div>
        <a href="@Url.Action("Index", "Report")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Hub</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 fw-bold">Team Member Workload Summary</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th class="text-center">Leads Assigned</th>
                        <th class="text-center">Opportunities</th>
                        <th class="text-center">Follow-ups Assigned</th>
                        <th class="text-center">Completed Follow-ups</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@u.UserName</td>
                                <td>@u.Email</td>
                                <td class="text-center"><span class="badge bg-primary fs-6">@u.LeadsAssigned</span></td>
                                <td class="text-center"><span class="badge bg-success fs-6">@u.OpportunitiesAssigned</span></td>
                                <td class="text-center"><span class="badge bg-warning text-dark fs-6">@u.FollowUpsAssigned</span></td>
                                <td class="text-center"><span class="badge bg-info text-dark fs-6">@u.CompletedFollowUps</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No user activity recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
