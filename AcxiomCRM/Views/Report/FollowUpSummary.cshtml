@model AcxiomCRM.DTOs.FollowUpSummaryReportDto
@{
    ViewData["Title"] = "Follow-up Metrics Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-check text-warning me-2"></i>Follow-up Metrics Report</h2>
        <p class="text-muted mb-0">Scheduled, completed, and overdue follow-up interactions</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Report")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Hub</a>
        <a href="@Url.Action("ExportCsv", "Report", new { reportType = "followup" })" class="btn btn-success"><i class="bi bi-download me-1"></i> Export CSV</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="small text-white-50 text-uppercase fw-semibold">Total Follow-ups</div>
                <div class="h2 fw-bold mb-0">@Model.TotalFollowUps</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="small text-dark-50 text-uppercase fw-semibold">Pending / Planned</div>
                <div class="h2 fw-bold mb-0">@Model.PendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="small text-white-50 text-uppercase fw-semibold">Completed</div>
                <div class="h2 fw-bold mb-0">@Model.CompletedCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body">
                <div class="small text-white-50 text-uppercase fw-semibold">Overdue</div>
                <div class="h2 fw-bold mb-0">@Model.OverdueCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 fw-bold">Follow-ups by Interaction Type</div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th class="text-end">Count</th>
                    <th class="text-end">Share (%)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.ByType)
                {
                    var pct = Model.TotalFollowUps > 0 ? (t.Count * 100.0 / Model.TotalFollowUps).ToString("F1") : "0";
                    <tr>
                        <td class="fw-semibold">@t.Status</td>
                        <td class="text-end fw-bold">@t.Count</td>
                        <td class="text-end text-muted">@pct%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
