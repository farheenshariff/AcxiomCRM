@model LeadCreateViewModel
@{
    ViewData["Title"] = "Create Lead";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-person-plus-fill text-warning me-2"></i>Create New Prospect Lead</h2>
        <p class="text-muted small m-0 mt-1">Capture lead details, source, expected deal value, and assign sales representative.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LeadCode" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="LeadCode" class="form-control font-monospace" readonly />
                        <span asp-validation-for="LeadCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="LeadName" class="form-control" placeholder="Sarah Jenkins" autofocus />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" class="form-control" placeholder="sjenkins@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+1-555-0822" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Vertex Media" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Source" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Source" class="form-select">
                            <option value="Website">Website</option>
                            <option value="Referral">Referral</option>
                            <option value="Trade Show">Trade Show</option>
                            <option value="Cold Call">Cold Call</option>
                            <option value="Social Media">Social Media</option>
                        </select>
                        <span asp-validation-for="Source" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="New">New</option>
                            <option value="Contacted">Contacted</option>
                            <option value="Qualified">Qualified</option>
                            <option value="Unqualified">Unqualified</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExpectedValue" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input asp-for="ExpectedValue" class="form-control" placeholder="45000" />
                        </div>
                        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="AssignedTo" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.UsersList">
                            <option value="">-- Unassigned --</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border fw-semibold px-4">Cancel</a>
                    <button type="submit" class="btn btn-warning fw-bold px-4"><i class="bi bi-check-lg me-1"></i> Save Lead</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
