@model LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-person-badge-fill text-warning me-2"></i>Lead Management</h2>
        <p class="text-muted small m-0 mt-1">Track prospect pipelines, assign representatives, and convert qualified leads.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-warning fw-bold shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> Add New Lead</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search lead name, email, company, code..." />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                    <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(Model.StatusFilter == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="priorityFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Priorities</option>
                    <option value="High" selected="@(Model.PriorityFilter == "High")">High Priority</option>
                    <option value="Medium" selected="@(Model.PriorityFilter == "Medium")">Medium Priority</option>
                    <option value="Low" selected="@(Model.PriorityFilter == "Low")">Low Priority</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <select name="assignedUserFilter" class="form-select" asp-items="Model.UsersList" onchange="this.form.submit()">
                    <option value="">All Assigned Users</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-dark fw-bold w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Lead Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Lead Code</th>
                    <th>Lead Name</th>
                    <th>Company / Source</th>
                    <th>Expected Value</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Assigned Representative</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    @foreach (var lead in Model.Leads)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@lead.LeadCode</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="fw-bold text-dark text-decoration-none h6 mb-0 d-block">@lead.LeadName</a>
                                <span class="text-muted small"><i class="bi bi-envelope me-1"></i>@lead.Email</span>
                            </td>
                            <td>
                                <div class="fw-semibold">@(lead.CompanyName ?? "-")</div>
                                @if (!string.IsNullOrEmpty(lead.Source))
                                {
                                    <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">@lead.Source</span>
                                }
                            </td>
                            <td class="fw-bold text-success">$@lead.ExpectedValue.ToString("N0")</td>
                            <td>
                                @if (lead.Priority == "High")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">High</span>
                                }
                                else if (lead.Priority == "Medium")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Low</span>
                                }
                            </td>
                            <td>
                                @if (lead.Status == "Converted")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-all me-1"></i>Converted</span>
                                }
                                else if (lead.Status == "Qualified")
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-star-fill me-1"></i>Qualified</span>
                                }
                                else if (lead.Status == "Lost")
                                {
                                    <span class="badge bg-secondary">Lost</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@lead.Status</span>
                                }
                            </td>
                            <td class="small">
                                <i class="bi bi-person me-1 text-muted"></i>@(lead.AssignedTo ?? "Unassigned")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (lead.Status != "Converted")
                                    {
                                        <a asp-action="Convert" asp-route-id="@lead.LeadId" class="btn btn-success fw-bold" title="Convert Lead to Account/Opportunity"><i class="bi bi-arrow-right-circle me-1"></i> Convert</a>
                                        <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                    @if (lead.Status != "Converted")
                                    {
                                        <form asp-action="Delete" asp-route-id="@lead.LeadId" method="post" class="d-inline" onsubmit="return confirm('Mark lead as Lost?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Mark Lost"><i class="bi bi-x-circle"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-person-badge display-4 d-block mb-2 text-secondary"></i>
                            <h5>No Leads Found</h5>
                            <p class="small">No lead records match your search criteria or authorization scope.</p>
                            <a asp-action="Create" class="btn btn-sm btn-warning fw-bold"><i class="bi bi-plus-lg me-1"></i> Create Lead</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Leads.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing Page <strong>@Model.Leads.PageIndex</strong> of <strong>@Model.Leads.TotalPages</strong> (@Model.Leads.TotalCount Total Records)</span>
            <ul class="pagination pagination-sm m-0">
                <li class="page-item @(!Model.Leads.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Leads.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-priorityFilter="@Model.PriorityFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.Leads.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Leads.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-priorityFilter="@Model.PriorityFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Leads.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Leads.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-priorityFilter="@Model.PriorityFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
