@model CustomerEditViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Customer Details</h2>
        <p class="text-muted small m-0 mt-1">Update customer account profile, contact information, or status.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CustomerId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerCode" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CustomerCode" class="form-control font-monospace" readonly />
                        <span asp-validation-for="CustomerCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CustomerName" class="form-control" autofocus />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="State" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="State" class="form-control" />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border fw-semibold px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4"><i class="bi bi-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
