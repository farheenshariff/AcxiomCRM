@model CustomerListViewModel
@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-people-fill text-primary me-2"></i>Customer Management</h2>
        <p class="text-muted small m-0 mt-1">Manage active enterprise accounts, contacts, addresses, and history.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> Add New Customer</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name, email, phone, code or company..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active Only</option>
                    <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive Only</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                    <option value="name" selected="@(Model.SortOrder == "name")">Sort by Name</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Name (Z-A)</option>
                    <option value="date_desc" selected="@(Model.SortOrder == "date_desc")">Newest First</option>
                    <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Oldest First</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-dark fw-bold w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Customer Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email / Phone</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Any())
                {
                    @foreach (var cust in Model.Customers)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@cust.CustomerCode</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@cust.CustomerId" class="fw-bold text-dark text-decoration-none h6 mb-0 d-block">@cust.CustomerName</a>
                                <span class="text-muted small">Created @cust.CreatedDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>@(cust.CompanyName ?? "-")</td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i><a href="mailto:@cust.Email" class="text-decoration-none">@cust.Email</a></div>
                                @if (!string.IsNullOrEmpty(cust.Phone))
                                {
                                    <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>@cust.Phone</div>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(cust.City) || !string.IsNullOrEmpty(cust.State))
                                {
                                    <span>@cust.City@(!string.IsNullOrEmpty(cust.City) && !string.IsNullOrEmpty(cust.State) ? ", " : "")@cust.State</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (cust.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@cust.CustomerId" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@cust.CustomerId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@cust.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate/delete this customer?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Deactivate/Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-4 d-block mb-2 text-secondary"></i>
                            <h5>No Customers Found</h5>
                            <p class="small">No customer records match your filter criteria or authorization scope.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary fw-bold"><i class="bi bi-plus-lg me-1"></i> Add Customer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (Model.Customers.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing Page <strong>@Model.Customers.PageIndex</strong> of <strong>@Model.Customers.TotalPages</strong> (@Model.Customers.TotalCount Total Records)</span>
            <ul class="pagination pagination-sm m-0">
                <li class="page-item @(!Model.Customers.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Customers.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-sortOrder="@Model.SortOrder">Previous</a>
                </li>
                @for (int i = 1; i <= Model.Customers.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Customers.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-sortOrder="@Model.SortOrder">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Customers.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Customers.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-sortOrder="@Model.SortOrder">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
