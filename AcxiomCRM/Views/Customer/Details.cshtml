@model CustomerDetailsViewModel
@{
    ViewData["Title"] = "Customer Profile - " + Model.Customer.CustomerName;
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-person-vcard text-primary me-2"></i>@Model.Customer.CustomerName</h2>
        <span class="badge bg-light text-dark border font-monospace mt-1">@Model.Customer.CustomerCode</span>
        <span class="badge bg-success-subtle text-success border border-success ms-1">@Model.Customer.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-primary fw-bold"><i class="bi bi-pencil me-1"></i> Edit Account</a>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<!-- Header Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="small text-muted text-uppercase fw-semibold">Total Revenue Closed</div>
            <div class="h3 fw-bold text-success m-0">$@Model.TotalClosedRevenue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="small text-muted text-uppercase fw-semibold">Active Opportunities Pipeline</div>
            <div class="h3 fw-bold text-primary m-0">$@Model.ActivePipelineValue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="small text-muted text-uppercase fw-semibold">Total Follow-Ups</div>
            <div class="h3 fw-bold text-warning m-0">@Model.FollowUps.Count()</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="small text-muted text-uppercase fw-semibold">Total Activities</div>
            <div class="h3 fw-bold text-info m-0">@Model.Activities.Count()</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Customer Details Panel -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-building me-2 text-primary"></i>Company Information</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-4 text-secondary">Company:</dt>
                <dd class="col-sm-8 fw-semibold">@(Model.Customer.CompanyName ?? "-")</dd>

                <dt class="col-sm-4 text-secondary">Email:</dt>
                <dd class="col-sm-8"><a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></dd>

                <dt class="col-sm-4 text-secondary">Phone:</dt>
                <dd class="col-sm-8">@(Model.Customer.Phone ?? "-")</dd>

                <dt class="col-sm-4 text-secondary">Address:</dt>
                <dd class="col-sm-8">@(Model.Customer.Address ?? "-")</dd>

                <dt class="col-sm-4 text-secondary">City/State:</dt>
                <dd class="col-sm-8">@Model.Customer.City, @Model.Customer.State</dd>

                <dt class="col-sm-4 text-secondary">Created By:</dt>
                <dd class="col-sm-8">@(Model.Customer.CreatedBy ?? "System")</dd>

                <dt class="col-sm-4 text-secondary">Created On:</dt>
                <dd class="col-sm-8">@Model.Customer.CreatedDate.ToString("MMM dd, yyyy")</dd>
            </dl>
        </div>
    </div>

    <!-- Related Entities Tabs -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-header bg-white border-0 pt-3 px-3">
                <ul class="nav nav-tabs card-header-tabs" id="customerTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps" type="button" role="tab"><i class="bi bi-graph-up-arrow me-1 text-success"></i> Opportunities (@Model.Opportunities.Count())</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab"><i class="bi bi-calendar-event me-1 text-warning"></i> Follow-Ups (@Model.FollowUps.Count())</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab"><i class="bi bi-check2-square me-1 text-info"></i> Activities (@Model.Activities.Count())</button>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content p-3" id="customerTabsContent">
                <!-- Opportunities Tab -->
                <div class="tab-pane fade show active" id="opps" role="tabpanel">
                    @if (Model.Opportunities.Any())
                    {
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Amount</th>
                                    <th>Stage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="fw-bold">@opp.OpportunityName</td>
                                        <td class="text-success fw-semibold">$@opp.Amount.ToString("N0")</td>
                                        <td><span class="badge bg-secondary">@opp.Stage</span></td>
                                        <td><span class="badge bg-info text-dark">@opp.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No opportunities linked to this customer.</p>
                    }
                </div>

                <!-- Follow-Ups Tab -->
                <div class="tab-pane fade" id="followups" role="tabpanel">
                    @if (Model.FollowUps.Any())
                    {
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var follow in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-bold">@follow.Subject</td>
                                        <td>@follow.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                        <td>@follow.FollowUpType</td>
                                        <td><span class="badge bg-warning text-dark">@follow.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No follow-ups recorded for this customer.</p>
                    }
                </div>

                <!-- Activities Tab -->
                <div class="tab-pane fade" id="activities" role="tabpanel">
                    @if (Model.Activities.Any())
                    {
                        <table class="table table-hover align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Assigned To</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var act in Model.Activities)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">@act.ActivityType</span></td>
                                        <td class="fw-bold">@act.Subject</td>
                                        <td>@act.ActivityDate.ToString("MMM dd, yyyy")</td>
                                        <td>@act.AssignedTo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No activities recorded for this customer.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
