@model OpportunityListViewModel
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Opportunity Pipeline</h2>
        <p class="text-muted small m-0 mt-1">Track sales stages, win probabilities, and weighted pipeline values.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Board" class="btn btn-outline-success fw-bold"><i class="bi bi-kanban me-1"></i> Kanban Board</a>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Opportunity</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Metrics Banner -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-6">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="text-uppercase text-muted fw-semibold small">Total Open Pipeline Value</div>
            <div class="h3 fw-bold text-primary m-0">$@Model.TotalPipelineValue.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-6">
        <div class="card border-0 shadow-sm p-3 bg-white">
            <div class="text-uppercase text-muted fw-semibold small">Weighted Forecast (Prob. Adj.)</div>
            <div class="h3 fw-bold text-success m-0">$@Model.TotalWeightedValue.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search opportunity name, customer..." />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select name="stageFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(Model.StatusFilter == "Open")">Open</option>
                    <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <select name="assignedUserFilter" class="form-select" asp-items="Model.UsersList" onchange="this.form.submit()">
                    <option value="">All Representatives</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-dark fw-bold w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunity Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Account / Lead</th>
                    <th>Deal Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Target Close Date</th>
                    <th>Assigned Rep</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    @foreach (var opp in Model.Opportunities)
                    {
                        var weighted = opp.Amount * (opp.Probability / 100.0m);
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-dark text-decoration-none h6 mb-0 d-block">@opp.OpportunityName</a>
                            </td>
                            <td>
                                @if (opp.Customer != null)
                                {
                                    <span class="fw-semibold text-dark"><i class="bi bi-building me-1 text-primary"></i>@opp.Customer.CustomerName</span>
                                }
                                else if (opp.Lead != null)
                                {
                                    <span class="text-muted"><i class="bi bi-person me-1 text-warning"></i>@opp.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="fw-bold text-success">$@opp.Amount.ToString("N0")</td>
                            <td>
                                @if (opp.Stage == "Won")
                                {
                                    <span class="badge bg-success">Won</span>
                                }
                                else if (opp.Stage == "Lost")
                                {
                                    <span class="badge bg-secondary">Lost</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@opp.Stage</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(opp.Probability)%" aria-valuenow="@opp.Probability" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="small fw-semibold">@(opp.Probability)%</span>
                                </div>
                            </td>
                            <td class="fw-semibold text-dark">$@weighted.ToString("N0")</td>
                            <td class="small">@(opp.ExpectedCloseDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                            <td class="small text-muted">@(opp.AssignedTo ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@opp.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Mark opportunity as Lost?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Mark Lost"><i class="bi bi-x-circle"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-graph-up display-4 d-block mb-2 text-secondary"></i>
                            <h5>No Opportunities Found</h5>
                            <p class="small">No sales opportunities match your filter criteria or authorization scope.</p>
                            <a asp-action="Create" class="btn btn-sm btn-success fw-bold"><i class="bi bi-plus-lg me-1"></i> Add Opportunity</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Opportunities.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing Page <strong>@Model.Opportunities.PageIndex</strong> of <strong>@Model.Opportunities.TotalPages</strong> (@Model.Opportunities.TotalCount Total Records)</span>
            <ul class="pagination pagination-sm m-0">
                <li class="page-item @(!Model.Opportunities.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Opportunities.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.Opportunities.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Opportunities.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Opportunities.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Opportunities.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
