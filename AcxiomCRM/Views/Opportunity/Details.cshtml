@model OpportunityDetailsViewModel
@{
    ViewData["Title"] = "Opportunity Details - " + Model.Opportunity.OpportunityName;
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>@Model.Opportunity.OpportunityName</h2>
        <span class="badge bg-success fs-6 mt-1">Stage: @Model.Opportunity.Stage</span>
        <span class="badge bg-light text-dark border ms-1">Status: @Model.Opportunity.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-primary fw-bold"><i class="bi bi-pencil me-1"></i> Edit Opportunity</a>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-cash-stack text-success me-2"></i>Financial & Stage Details</h5>
            <dl class="row mb-0 small">
                <dt class="col-sm-5 text-secondary">Deal Amount:</dt>
                <dd class="col-sm-7 text-success fw-bold h5">$@Model.Opportunity.Amount.ToString("N0")</dd>

                <dt class="col-sm-5 text-secondary">Win Probability:</dt>
                <dd class="col-sm-7 fw-bold">@Model.Opportunity.Probability%</dd>

                <dt class="col-sm-5 text-secondary">Weighted Value:</dt>
                <dd class="col-sm-7 text-primary fw-bold">$@Model.WeightedValue.ToString("N0")</dd>

                <dt class="col-sm-5 text-secondary">Associated Account:</dt>
                <dd class="col-sm-7 fw-semibold">
                    @if (Model.Opportunity.Customer != null)
                    {
                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId">@Model.Opportunity.Customer.CustomerName</a>
                    }
                    else if (Model.Opportunity.Lead != null)
                    {
                        <a asp-controller="Lead" asp-action="Details" asp-route-id="@Model.Opportunity.LeadId">@Model.Opportunity.Lead.LeadName</a>
                    }
                    else
                    {
                        <span class="text-muted">Unlinked</span>
                    }
                </dd>

                <dt class="col-sm-5 text-secondary">Target Close Date:</dt>
                <dd class="col-sm-7">@(Model.Opportunity.ExpectedCloseDate?.ToString("MMM dd, yyyy") ?? "-")</dd>

                <dt class="col-sm-5 text-secondary">Assigned Rep:</dt>
                <dd class="col-sm-7">@(Model.Opportunity.AssignedTo ?? "Unassigned")</dd>

                <dt class="col-sm-5 text-secondary">Created On:</dt>
                <dd class="col-sm-7">@Model.Opportunity.CreatedDate.ToString("MMM dd, yyyy")</dd>
            </dl>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-sticky me-2 text-info"></i>Opportunity Notes & Strategy</h5>
            <p class="text-secondary" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Opportunity.Notes) ? "No notes recorded for this opportunity." : Model.Opportunity.Notes)</p>
        </div>
    </div>
</div>
