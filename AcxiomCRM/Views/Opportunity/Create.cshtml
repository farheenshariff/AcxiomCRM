@model OpportunityCreateViewModel
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Create New Opportunity</h2>
        <p class="text-muted small m-0 mt-1">Set up deal details, amount, probability, and expected close date.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="OpportunityName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="Acme Enterprise Upgrade Package" autofocus />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomersList">
                            <option value="">-- Select Customer Account --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="LeadId" class="form-select" asp-items="Model.LeadsList">
                            <option value="">-- Select Associated Lead --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Amount" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Amount" class="form-control" placeholder="120000" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Stage" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Stage" class="form-select">
                            <option value="Qualification">Qualification</option>
                            <option value="Proposal">Proposal</option>
                            <option value="Negotiation">Negotiation</option>
                            <option value="Won">Won</option>
                            <option value="Lost">Lost</option>
                        </select>
                        <span asp-validation-for="Stage" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Probability" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <input asp-for="Probability" class="form-control" placeholder="50" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Probability" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AssignedTo" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.UsersList">
                            <option value="">-- Unassigned --</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter deal notes, requirements, or next steps..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border fw-semibold px-4">Cancel</a>
                    <button type="submit" class="btn btn-success fw-bold px-4"><i class="bi bi-check-lg me-1"></i> Save Opportunity</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
