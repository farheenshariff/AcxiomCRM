@model ActivityCreateViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-plus-circle-fill text-info me-2"></i>Log Sales Activity</h2>
        <p class="text-muted small m-0 mt-1">Record phone calls, client meetings, emails, or completed tasks.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="ActivityType" class="form-select">
                            <option value="Call">Call</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Email">Email</option>
                            <option value="Task">Task</option>
                        </select>
                        <span asp-validation-for="ActivityType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityDate" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="ActivityDate" type="datetime-local" class="form-control" value="@Model.ActivityDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Subject" class="form-control" placeholder="Product Catalog & Price Demo Meeting" autofocus />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="Model.CustomersList">
                            <option value="">-- Select Customer Account --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="LeadId" class="form-select" asp-items="Model.LeadsList">
                            <option value="">-- Select Prospect Lead --</option>
                        </select>
                        <span asp-validation-for="LeadId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="AssignedTo" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="Model.UsersList">
                            <option value="">-- Unassigned --</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter activity log notes or discussion summary..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border fw-semibold px-4">Cancel</a>
                    <button type="submit" class="btn btn-info text-white fw-bold px-4"><i class="bi bi-check-lg me-1"></i> Log Activity Entry</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
