@model ActivityListViewModel
@{
    ViewData["Title"] = "Activity Log";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-check2-square text-info me-2"></i>Activity Logging</h2>
        <p class="text-muted small m-0 mt-1">Log phone calls, client meetings, sent emails, and completed sales tasks.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-info text-white fw-bold shadow-sm"><i class="bi bi-plus-lg me-1"></i> Log Activity</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search subject, description, customer..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="typeFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="assignedUserFilter" class="form-select" asp-items="Model.UsersList" onchange="this.form.submit()">
                    <option value="">All Representatives</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-dark fw-bold w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Activity Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Type</th>
                    <th>Subject & Description</th>
                    <th>Date & Time</th>
                    <th>Account / Lead</th>
                    <th>Representative</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activities.Any())
                {
                    @foreach (var act in Model.Activities)
                    {
                        <tr>
                            <td>
                                @if (act.ActivityType == "Call")
                                {
                                    <span class="badge bg-primary"><i class="bi bi-telephone me-1"></i>Call</span>
                                }
                                else if (act.ActivityType == "Meeting")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-people me-1"></i>Meeting</span>
                                }
                                else if (act.ActivityType == "Email")
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-envelope me-1"></i>Email</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-check2-square me-1"></i>Task</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@act.Subject</div>
                                @if (!string.IsNullOrEmpty(act.Description))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 300px;">@act.Description</div>
                                }
                            </td>
                            <td class="small">
                                <div>@act.ActivityDate.ToString("MMM dd, yyyy")</div>
                                <span class="text-muted">@act.ActivityDate.ToString("hh:mm tt")</span>
                            </td>
                            <td>
                                @if (act.Customer != null)
                                {
                                    <span class="fw-semibold text-primary"><i class="bi bi-building me-1"></i>@act.Customer.CustomerName</span>
                                }
                                else if (act.Lead != null)
                                {
                                    <span class="fw-semibold text-warning"><i class="bi bi-person me-1"></i>@act.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="small text-muted">@(act.AssignedTo ?? "Unassigned")</td>
                            <td><span class="badge bg-success">@act.Status</span></td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@act.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity entry?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Entry"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-check2-square display-4 d-block mb-2 text-secondary"></i>
                            <h5>No Activities Found</h5>
                            <p class="small">No activity logs match your filter criteria or authorization scope.</p>
                            <a asp-action="Create" class="btn btn-sm btn-info text-white fw-bold"><i class="bi bi-plus-lg me-1"></i> Log Activity</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Activities.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing Page <strong>@Model.Activities.PageIndex</strong> of <strong>@Model.Activities.TotalPages</strong> (@Model.Activities.TotalCount Total Records)</span>
            <ul class="pagination pagination-sm m-0">
                <li class="page-item @(!Model.Activities.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Activities.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.Activities.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Activities.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Activities.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Activities.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter" asp-route-assignedUserFilter="@Model.AssignedUserFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
