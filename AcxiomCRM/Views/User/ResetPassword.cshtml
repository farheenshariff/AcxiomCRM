@model UserResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-key-fill text-warning me-2"></i>Reset User Password</h2>
        <p class="text-muted small m-0 mt-1">Admin Security: Secure password reset mechanism for user account <strong>@Model.Email</strong>.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
            <form asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

                <div class="alert alert-light border p-3 mb-4">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-person me-1"></i>Target Account</div>
                    <div class="font-monospace text-primary">@Model.Email</div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="NewPassword" class="form-control" placeholder="••••••••" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="ConfirmNewPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border fw-semibold px-4">Cancel</a>
                    <button type="submit" class="btn btn-warning fw-bold px-4"><i class="bi bi-shield-check me-1"></i> Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
