@model UserListViewModel
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold text-dark m-0"><i class="bi bi-people-fill text-danger me-2"></i>User & Role Management</h2>
        <p class="text-muted small m-0 mt-1">Admin Console: Manage user accounts, role assignments, account status, and security password resets.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-danger fw-bold shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> Add New User</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name or email address..." />
                </div>
            </div>
            <div class="col-6 col-md-4">
                <select name="roleFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                    <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                    <option value="SalesExecutive" selected="@(Model.RoleFilter == "SalesExecutive")">SalesExecutive</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-dark fw-bold w-100"><i class="bi bi-filter me-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- User Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark small text-uppercase">
                <tr>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Assigned Role</th>
                    <th>Account Status</th>
                    <th>Lockout Security</th>
                    <th>Created Date</th>
                    <th class="text-end">Admin Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@user.FullName</td>
                            <td class="font-monospace small">@user.Email</td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-shield-lock me-1"></i>Admin</span>
                                }
                                else if (user.Role == "Manager")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-briefcase me-1"></i>Manager</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-person-badge me-1"></i>SalesExecutive</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">Deactivated</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>LOCKED OUT</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Normal</span>
                                }
                            </td>
                            <td class="small text-muted">@user.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit User & Role"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-warning" title="Reset Password"><i class="bi bi-key"></i></a>
                                    
                                    @if (user.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Unlock Account"><i class="bi bi-unlock"></i></button>
                                        </form>
                                    }

                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle user active status?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-4 d-block mb-2 text-secondary"></i>
                            <h5>No Users Found</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Users.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing Page <strong>@Model.Users.PageIndex</strong> of <strong>@Model.Users.TotalPages</strong> (@Model.Users.TotalCount Total Records)</span>
            <ul class="pagination pagination-sm m-0">
                <li class="page-item @(!Model.Users.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Users.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.Users.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Users.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Users.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.Users.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-roleFilter="@Model.RoleFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
